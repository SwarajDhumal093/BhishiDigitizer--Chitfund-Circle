<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_app_gradient">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/btnBack" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_icon_circle" android:padding="10dp" android:src="@drawable/ic_arrow_back" android:contentDescription="Back" app:tint="@color/text_primary" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="@string/digital_receipt" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
            <ImageView android:layout_width="48dp" android:layout_height="42dp" android:adjustViewBounds="true" android:src="@drawable/bhishi_logo_mark" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_card" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_receipt_header" android:gravity="center_vertical" android:orientation="horizontal" android:padding="18dp">
                <ImageView android:layout_width="76dp" android:layout_height="62dp" android:adjustViewBounds="true" android:src="@drawable/bhishi_logo_mark" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bhishi Digitizer" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/brand_gold" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/amount_upper" android:textColor="@color/text_faint" android:textSize="9.5sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/brand_orange" android:textSize="30sp" android:textStyle="bold" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@color/line" />
                <TextView android:id="@+id/tvReceiptId" style="@style/ReceiptValue" android:layout_marginTop="14dp" />
                <TextView android:id="@+id/tvGroup" style="@style/ReceiptValue" />
                <TextView android:id="@+id/tvMember" style="@style/ReceiptValue" />
                <TextView android:id="@+id/tvCycle" style="@style/ReceiptValue" />
                <TextView android:id="@+id/tvMethod" style="@style/ReceiptValue" />
                <TextView android:id="@+id/tvReference" style="@style/ReceiptValue" />
                <TextView android:id="@+id/tvDate" style="@style/ReceiptValue" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
            <TextView android:id="@+id/btnDownload" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:background="@drawable/bg_button_primary" android:drawableStart="@drawable/ic_download" android:drawablePadding="7dp" android:gravity="center" android:text="@string/download_pdf" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/btnShare" android:layout_width="0dp" android:layout_height="54dp" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/bg_button_outline" android:drawableStart="@drawable/ic_share" android:drawablePadding="7dp" android:gravity="center" android:text="@string/share_receipt" android:textColor="@color/brand_orange" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
