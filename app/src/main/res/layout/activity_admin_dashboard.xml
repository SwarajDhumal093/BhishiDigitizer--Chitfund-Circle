<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dashboardScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="46dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/bhishi_logo_mark" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/welcome_back"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/admin_dashboard_title"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnNotifications"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="Notifications"
                    android:padding="10dp"
                    android:src="@drawable/ic_bell" />

                <ImageView
                    android:id="@+id/btnProfile"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="Profile"
                    android:padding="10dp"
                    android:src="@drawable/ic_profile" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_dashboard_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/brand_promise_short"
                        android:textColor="#FFD7A8"
                        android:textSize="8.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAdminSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/admin_banner_title"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAdminSubSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/admin_banner_subtitle"
                        android:textColor="#CDE3EA"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="66dp"
                    android:layout_marginStart="12dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/bhishi_logo_mark" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/overview_today"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_metric_teal"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_group" app:tint="#59E0E5" />
                    <TextView android:id="@+id/tvMetricGroups" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0" android:textColor="@color/white" android:textSize="23sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/active_bhishis" android:textColor="#C7E9EB" android:textSize="10.5sp" />
                </LinearLayout>
                <Space android:layout_width="10dp" android:layout_height="1dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_metric_orange"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_clock" />
                    <TextView android:id="@+id/tvMetricDue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0" android:textColor="@color/white" android:textSize="23sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/due_payments" android:textColor="#F4D7C2" android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="112dp" android:layout_weight="1" android:background="@drawable/bg_metric_navy" android:orientation="vertical" android:padding="14dp">
                    <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_wallet" app:tint="@color/brand_gold" />
                    <TextView android:id="@+id/tvMetricPool" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="₹0" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pool_amount" android:textColor="#C8D8DF" android:textSize="10.5sp" />
                </LinearLayout>
                <Space android:layout_width="10dp" android:layout_height="1dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="112dp" android:layout_weight="1" android:background="@drawable/bg_metric_navy" android:orientation="vertical" android:padding="14dp">
                    <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_profile" app:tint="@color/brand_teal" />
                    <TextView android:id="@+id/tvMetricMembers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0" android:textColor="@color/white" android:textSize="23sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/members" android:textColor="#C8D8DF" android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/quick_actions" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/savings_circles_simplified" android:textColor="@color/text_faint" android:textSize="9.5sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                <LinearLayout android:id="@+id/quickCreate" style="@style/QuickActionStyle"><ImageView style="@style/QuickActionIcon" android:src="@drawable/ic_add_group"/><TextView style="@style/QuickActionText" android:text="@string/create_group"/></LinearLayout>
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <LinearLayout android:id="@+id/quickInvite" style="@style/QuickActionStyle"><ImageView style="@style/QuickActionIcon" android:src="@drawable/ic_qr"/><TextView style="@style/QuickActionText" android:text="@string/invite_members"/></LinearLayout>
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <LinearLayout android:id="@+id/quickDraw" style="@style/QuickActionStyle"><ImageView style="@style/QuickActionIcon" android:src="@drawable/ic_trophy"/><TextView style="@style/QuickActionText" android:text="@string/lucky_draw"/></LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <LinearLayout android:id="@+id/quickAuction" style="@style/QuickActionStyle"><ImageView style="@style/QuickActionIcon" android:src="@drawable/ic_gavel"/><TextView style="@style/QuickActionText" android:text="@string/sealed_auction"/></LinearLayout>
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <LinearLayout android:id="@+id/quickReceipts" style="@style/QuickActionStyle"><ImageView style="@style/QuickActionIcon" android:src="@drawable/ic_receipt"/><TextView style="@style/QuickActionText" android:text="@string/receipts"/></LinearLayout>
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <LinearLayout android:id="@+id/quickReports" style="@style/QuickActionStyle"><ImageView style="@style/QuickActionIcon" android:src="@drawable/ic_chart"/><TextView style="@style/QuickActionText" android:text="@string/reports"/></LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <LinearLayout android:id="@+id/quickCalendar" style="@style/QuickActionStyle"><ImageView style="@style/QuickActionIcon" android:src="@drawable/ic_clock"/><TextView style="@style/QuickActionText" android:text="@string/financial_calendar"/></LinearLayout>
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <LinearLayout android:id="@+id/quickRules" style="@style/QuickActionStyle"><ImageView style="@style/QuickActionIcon" android:src="@drawable/ic_shield_check"/><TextView style="@style/QuickActionText" android:text="@string/group_rules"/></LinearLayout>
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <LinearLayout android:id="@+id/quickClosure" style="@style/QuickActionStyle"><ImageView style="@style/QuickActionIcon" android:src="@drawable/ic_lock"/><TextView style="@style/QuickActionText" android:text="@string/closure"/></LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/recent_groups" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tap_to_manage" android:textColor="@color/text_faint" android:textSize="10sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGroups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="12dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout style="@style/BottomNavItem">
            <FrameLayout style="@style/BottomNavIconWrap"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_group" app:tint="@color/brand_orange" /></FrameLayout>
            <TextView style="@style/BottomNavLabel" android:text="@string/home" android:textColor="@color/brand_orange" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navPassbook" style="@style/BottomNavItem">
            <FrameLayout style="@style/BottomNavIconWrap"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_wallet" app:tint="@color/text_secondary" /></FrameLayout>
            <TextView style="@style/BottomNavLabel" android:text="@string/passbook" android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navReceipts" style="@style/BottomNavItem">
            <FrameLayout style="@style/BottomNavIconWrap"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_receipt" app:tint="@color/text_secondary" /></FrameLayout>
            <TextView style="@style/BottomNavLabel" android:text="@string/receipts" android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navProfile" style="@style/BottomNavItem">
            <FrameLayout style="@style/BottomNavIconWrap"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_profile" app:tint="@color/text_secondary" /></FrameLayout>
            <TextView style="@style/BottomNavLabel" android:text="@string/profile" android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
