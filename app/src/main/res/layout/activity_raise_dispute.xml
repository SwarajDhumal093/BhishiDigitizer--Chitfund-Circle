<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icon_circle"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Raise a dispute"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"
            android:text="Describe the issue clearly. Once the admin resolves and locks it, the resolution becomes part of the permanent record."
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp"
            android:lineSpacingExtra="2dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/line"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView style="@style/FieldLabel" android:text="MONTH / CYCLE" />
                <EditText android:id="@+id/etMonth" style="@style/FieldInput" android:hint="e.g. September 2026" />

                <TextView style="@style/FieldLabel" android:text="WHAT HAPPENED?" />
                <EditText
                    android:id="@+id/etIssue"
                    style="@style/FieldInput"
                    android:layout_height="132dp"
                    android:gravity="top|start"
                    android:hint="Example: I paid online, but the ledger still shows pending…"
                    android:inputType="textMultiLine"
                    android:maxLength="500" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:text="Submit dispute for review"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
