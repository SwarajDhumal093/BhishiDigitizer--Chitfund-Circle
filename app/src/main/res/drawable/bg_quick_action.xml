<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_alt" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/brand_orange" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="@color/surface_card_start" android:endColor="@color/surface_card_end" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/line" />
        </shape>
    </item>
</selector>
