# Local port. Render supplies PORT automatically, so this is optional there.
PORT=8080

# Firebase Realtime Database ROOT URL only (no /groups, /data, .json, etc.).
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com

# Recommended on Render: paste the complete Firebase service-account JSON
# as ONE environment-variable value. Do not commit the real JSON/key.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Alternative to FIREBASE_SERVICE_ACCOUNT_JSON (use all three together):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Razorpay is OPTIONAL for the current milestone. Leave blank until needed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
